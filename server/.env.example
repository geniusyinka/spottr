# Required: OpenAI API key (kept server-side only — never ships to the mobile app)
OPENAI_API_KEY=sk-...

# Optional: Realtime model. Default: gpt-4o-realtime-preview-2024-12-17
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview-2024-12-17

# Optional: voice (alloy | ash | ballad | coral | echo | sage | shimmer | verse)
OPENAI_REALTIME_VOICE=verse

# Optional: server port
PORT=8787

# Optional: comma-separated allowed origins for CORS (default: *)
# ALLOWED_ORIGINS=http://localhost:8081,exp://192.168.1.10:8081

# --- LIVE personas (Spottr Pro) -------------------------------------------
# Required for /api/live/line: Fish Audio API key (API credit is billed
# separately from the Fish platform plan — top up at fish.audio/app/developers)
FISH_AUDIO_API_KEY=
# Optional: Fish model. Match the model the voice packs were rendered with so
# LIVE lines sound like the pre-recorded ones. Default: s1
# FISH_TTS_MODEL=s1
# Optional: Fish latency mode (normal | balanced). Default: balanced
# FISH_TTS_LATENCY=balanced
# Optional: the model that writes LIVE lines. Default: gpt-5.4-mini
# LIVE_LLM_MODEL=gpt-5.4-mini
# Optional: reasoning effort for that model. Default: none
# LIVE_LLM_REASONING=none

# --- Spottr Pro check -------------------------------------------------------
# RevenueCat v2 secret API key with only customer_information:customers:read
# (Project settings → API keys → + New secret key → API v2). When set,
# /api/realtime/session and /api/vision/describe require the X-RC-App-User-Id
# header to belong to a Pro user. /api/live/line refuses all requests without it.
# REVENUECAT_SECRET_KEY=sk_...
# Optional overrides (defaults are Spottr's): project id and the "Spottr Pro"
# entitlement's v2 id.
# REVENUECAT_PROJECT_ID=proj21c01bbe
# REVENUECAT_ENTITLEMENT_ID=entl68bd2d4127
