# Required: OpenAI API key (kept server-side only — never ships to the mobile app)
OPENAI_API_KEY=sk-...

# Optional: Realtime model. Default: gpt-4o-realtime-preview-2024-12-17
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview-2024-12-17

# Optional: voice (alloy | ash | ballad | coral | echo | sage | shimmer | verse)
OPENAI_REALTIME_VOICE=verse

# Optional: server port
PORT=8787

# Optional: comma-separated allowed origins for CORS (default: *)
# ALLOWED_ORIGINS=http://localhost:8081,exp://192.168.1.10:8081
